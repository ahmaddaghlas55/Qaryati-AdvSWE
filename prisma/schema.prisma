generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model AppUser {
  id            BigInt         @id @default(autoincrement())
  email         String         @unique
  passwordHash   String         @map("password_hash")
  role          String         @default("contributor")
  isActive      Boolean        @default(true) @map("is_active")
  createdAt     DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)
  refreshTokens RefreshToken[]
  auditLogs     AuditLog[]
  villagesCreated Village[] @relation("VillageCreatedBy")
  villagesReviewed Village[] @relation("VillageReviewedBy")
  villageNamesCreated VillageName[] @relation("VillageNameCreatedBy")
  villageNamesReviewed VillageName[] @relation("VillageNameReviewedBy")
  sourcesCreated Source[] @relation("SourceCreatedBy")
  @@map("app_users")
}

model RefreshToken {
  id         BigInt    @id @default(autoincrement())
  userId     BigInt    @map("user_id")
  tokenHash  String    @map("token_hash")
  expiresAt  DateTime  @map("expires_at") @db.Timestamptz(6)
  revokedAt  DateTime? @map("revoked_at") @db.Timestamptz(6)
  replacedBy BigInt?   @map("replaced_by")
  user       AppUser   @relation(fields: [userId], references: [id])
  @@map("refresh_tokens")
}

model Governorate {
  id   BigInt @id @default(autoincrement())
  slug String @unique
  nameAr String @map("name_ar")
  nameEn String @map("name_en")
  villages Village[]
  @@map("governorates")
}

model Village {
  id            BigInt    @id @default(autoincrement())
  slug          String    @unique
  governorateId BigInt    @map("governorate_id")
  municipality  String?
  overview      String?   @db.Text
  elevationM    Decimal?  @map("elevation_m") @db.Decimal(8, 2)
  areaKm2       Decimal?  @map("area_km2") @db.Decimal(10, 3)
  status        String    @default("proposed")
  supersedesId  BigInt?   @map("supersedes_id")
  sourceId      BigInt?   @map("source_id")
  createdBy     BigInt    @map("created_by")
  reviewedBy    BigInt?   @map("reviewed_by")
  reviewedAt    DateTime? @map("reviewed_at") @db.Timestamptz(6)
  reviewNote    String?   @map("review_note") @db.Text
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt     DateTime? @map("deleted_at") @db.Timestamptz(6)

  governorate   Governorate @relation(fields: [governorateId], references: [id])
  supersedes    Village?    @relation("VillageSupersession", fields: [supersedesId], references: [id])
  supersededBy  Village[]   @relation("VillageSupersession")
  source        Source?     @relation(fields: [sourceId], references: [id])
  creator       AppUser     @relation("VillageCreatedBy", fields: [createdBy], references: [id])
  reviewer      AppUser?     @relation("VillageReviewedBy", fields: [reviewedBy], references: [id])
  names         VillageName[]

  @@index([governorateId])
  @@index([status])
  @@map("villages")
}

model VillageName {
  id              BigInt    @id @default(autoincrement())
  villageId       BigInt    @map("village_id")
  value           String
  valueNormalized String?   @map("value_normalized")
  language        String
  type            String
  isCurrent       Boolean   @default(false) @map("is_current")
  validFrom       String?   @map("valid_from")
  validTo         String?   @map("valid_to")
  meaningOrOrigin String?   @map("meaning_or_origin") @db.Text
  status          String    @default("proposed")
  supersedesId    BigInt?   @map("supersedes_id")
  sourceId        BigInt?   @map("source_id")
  createdBy       BigInt    @map("created_by")
  reviewedBy      BigInt?   @map("reviewed_by")
  reviewedAt      DateTime? @map("reviewed_at") @db.Timestamptz(6)
  reviewNote      String?   @map("review_note") @db.Text
  createdAt       DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt       DateTime? @map("deleted_at") @db.Timestamptz(6)

  village      Village    @relation(fields: [villageId], references: [id])
  supersedes   VillageName? @relation("VillageNameSupersession", fields: [supersedesId], references: [id])
  supersededBy VillageName[] @relation("VillageNameSupersession")
  source       Source?    @relation(fields: [sourceId], references: [id])
  creator      AppUser    @relation("VillageNameCreatedBy", fields: [createdBy], references: [id])
  reviewer     AppUser?   @relation("VillageNameReviewedBy", fields: [reviewedBy], references: [id])

  @@index([villageId])
  @@map("village_names")
}

model Source {
  id              BigInt   @id @default(autoincrement())
  title           String
  author          String?
  publisher       String?
  url             String?
  publicationYear Int?     @map("publication_year")
  type            String
  createdBy       BigInt   @map("created_by")
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  creator        AppUser  @relation("SourceCreatedBy", fields: [createdBy], references: [id])
  villages       Village[]
  villageNames   VillageName[]

  @@index([type])
  @@map("sources")
}

model AuditLog {
  id          BigInt    @id @default(autoincrement())
  occurredAt  DateTime  @default(now()) @map("occurred_at") @db.Timestamptz(6)
  actorId     BigInt?   @map("actor_id")
  requestId   String?   @map("request_id")
  entityType  String    @map("entity_type")
  entityId    BigInt    @map("entity_id")
  action      String
  oldValue    Json?     @map("old_value")
  newValue    Json?     @map("new_value")
  actor       AppUser?  @relation(fields: [actorId], references: [id])
  @@index([entityType, entityId], map: "audit_entity_idx")
  @@index([actorId, occurredAt(sort: Desc)], map: "audit_actor_idx")
  @@map("audit_log")
}
